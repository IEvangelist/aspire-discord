{
  "name": "@aspire-discord/apphost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.apphost.json",
    "dev": "aspire run",
    "format": "prettier --write \"*.{json,mjs,mts}\" \"test/**/*.mts\"",
    "format:check": "prettier --check \"*.{json,mjs,mts}\" \"test/**/*.mts\"",
    "lint": "eslint apphost.mts deployment-pipeline.mts test/**/*.mts",
    "test": "node --import tsx --test test/*.test.mts",
    "typecheck": "tsc --noEmit -p tsconfig.apphost.json"
  },
  "dependencies": {
    "vscode-jsonrpc": "8.2.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "eslint": "10.0.3",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  }
}

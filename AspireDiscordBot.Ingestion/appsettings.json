{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "Ai": {
    "Provider": "azureaifoundry",
    "EmbeddingProvider": "azureaifoundry",
    "EmbeddingEndpoint": "",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "EmbeddingApiVersion": "2024-10-21"
  },
  "VectorStore": {
    "Provider": "qdrant",
    "Endpoint": "",
    "GenerationRetention": 2
  },
  "Ingestion": {
    "SourceMode": "cli",
    "CollectionName": "aspire_docs",
    "MaxChunkChars": 1200,
    "ChunkOverlapChars": 150,
    "ForceReindex": false,
    "SkipStartupIngestWhenPopulated": true,
    "RefreshIntervalHours": 24
  },
  "ApiSurface": {
    "Enabled": true,
    "RepositoryUrl": "https://github.com/microsoft/aspire.git",
    "SourceRef": "main",
    "CollectionName": "aspire_api",
    "IncludeProjectPrefixes": [
      "Aspire.Hosting"
    ],
    "CitationRepo": "microsoft/aspire",
    "SnapshotRetention": 3
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "Ai": {
    "Provider": "copilot",
    "Endpoint": "",
    "ApiKey": "",
    "ChatModel": "gpt-5.6-sol",
    "EmbeddingProvider": "ollama",
    "EmbeddingEndpoint": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimensions": 768,
    "ApiVersion": "2024-10-21",
    "Temperature": 0.1,
    "ReasoningEffort": "low",
    "MaxOutputTokens": 2000,
    "CaptureMessageContent": true
  },
  "Retrieval": {
    "TopK": 6,
    "MinScore": 0.35,
    "MaxContextChars": 8000
  },
  "Agent": {
    "Mode": "agentic",
    "MaxIterations": 5,
    "MaxToolCalls": 10,
    "SearchResultsPerCall": 6,
    "TimeoutSeconds": 90
  },
  "ApiSurface": {
    "Enabled": true,
    "CollectionName": "aspire_api",
    "CitationRepo": "microsoft/aspire",
    "SourceRef": "main"
  },
  "GitHubMcp": {
    "Enabled": true,
    "Endpoint": "https://api.githubcopilot.com/mcp/",
    "ReadOnly": true,
    "Lockdown": true,
    "AllowedRepositories": [
      "microsoft/aspire",
      "microsoft/aspire.dev"
    ]
  },
  "Safety": {
    "MaxQuestionLength": 600,
    "MinTopicScore": 0.35
  },
  "Discord": {
    "Token": "",
    "GuildId": null,
    "MentionEnabled": true,
    "AllowedUserIds": []
  }
}

{
  "name": "@aspire-discord/bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start": "node --enable-source-maps --import @azure/monitor-opentelemetry/loader dist/src/index.js",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run test/e2e",
    "test:integration": "vitest run test/integration",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@azure/app-configuration": "1.12.1",
    "@azure/identity": "4.13.2",
    "@azure/monitor-opentelemetry": "1.19.0",
    "@azure/search-documents": "13.0.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.8.1",
    "@github/copilot-sdk": "1.0.11",
    "@modelcontextprotocol/client": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation-pino": "0.67.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@qdrant/js-client-rest": "1.19.0",
    "@scalar/fastify-api-reference": "1.66.1",
    "discord.js": "14.27.0",
    "fastify": "5.12.1",
    "openai": "7.5.0",
    "pino": "10.3.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}

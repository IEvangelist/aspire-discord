<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Package sources are pinned to the two feeds that are reachable without
    interactive auth in this environment (public nuget.org is blocked and the
    aspire.dev / aspire-1p-sample feeds require credentials). These two mirror
    all packages this solution needs:
      - Aspire 13.5.0 (SDK + hosting + client integrations)
      - Microsoft.Extensions.* / OpenTelemetry / .NET runtime packages
  -->
  <packageSources>
    <clear />
    <add key="dotnetsite" value="https://pkgs.dev.azure.com/devdiv/OnlineServices/_packaging/dotnetsite/nuget/v3/index.json" />
    <add key="azure-default" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" />
  </packageSources>
</configuration>
